# Telegram Bot credentials
# Create a bot with @BotFather and paste the token into .env, never into GitHub.
TELEGRAM_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Scanner settings
WINDOW_DAYS=21
RSI_THRESHOLD=38
MA_LENGTH=200
SLEEP_SECONDS=1
MARKET_TIMEZONE=America/New_York

# File paths
HISTORY_FILE=history.json
LOG_FILE=stock_scan.log

# Scheduled-run network guard
# Live runs probe Yahoo and Telegram before scanning. The defaults perform one
# immediate attempt plus six retries at five-minute intervals (30 minutes).
DQP_NETWORK_PREFLIGHT_ENABLED=1
DQP_PREFLIGHT_MAX_WAIT_SECONDS=1800
DQP_PREFLIGHT_INTERVAL_SECONDS=300
DQP_PREFLIGHT_TIMEOUT_SECONDS=15

# Optional external dead-man monitor. Use a long, unguessable ntfy topic.
# The topic is runtime configuration and must never be committed with a real value.
DQP_MONITOR_TOPIC=
DQP_MONITOR_TIMEOUT_SECONDS=15
