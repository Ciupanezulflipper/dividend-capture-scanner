# Telegram Bot credentials
# Create a bot with @BotFather and paste the token into .env, never into GitHub.
TELEGRAM_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Scanner settings
WINDOW_DAYS=21
RSI_THRESHOLD=38
MA_LENGTH=200
SLEEP_SECONDS=1
MARKET_TIMEZONE=America/New_York

# File paths
HISTORY_FILE=history.json
LOG_FILE=stock_scan.log
